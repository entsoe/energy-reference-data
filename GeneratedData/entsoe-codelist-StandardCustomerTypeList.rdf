<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:cim="http://iec.ch/TC57/2013/CIM-schema-cim16#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:ecl="urn:entsoe.eu:wgedi:codelists" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <skos:ConceptScheme rdf:about="http://energy.referencedata.eu/StandardCustomerTypeList">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <dcterms:modified>2026-06-04</dcterms:modified>
    <dcat:version>95</dcat:version>
    <skos:prefLabel>StandardCustomerTypeList</skos:prefLabel>
    <dcterms:identifier>ET0013</dcterms:identifier>
    <skos:definition xml:lang="en">The coded identification of the type of customer such as household customer or company customer.</skos:definition>
  </skos:ConceptScheme>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardCustomerTypeList/A01">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <dcterms:identifier>A01</dcterms:identifier>
    <skos:prefLabel>Household customer</skos:prefLabel>
    <skos:definition xml:lang="en">The customer is a household customer.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardCustomerTypeList/A02">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <dcterms:identifier>A02</dcterms:identifier>
    <skos:prefLabel>Deceased household customer</skos:prefLabel>
    <skos:definition xml:lang="en">The customer is a deceased household customer. May be used for handling an estate of a deceased person, because the market parties often handle these customers in a different way as other customers.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardCustomerTypeList/A03">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <dcterms:identifier>A03</dcterms:identifier>
    <skos:prefLabel>Company customer</skos:prefLabel>
    <skos:definition xml:lang="en">The customer is a company customer.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardCustomerTypeList/A04">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardCustomerTypeList"/>
    <dcterms:identifier>A04</dcterms:identifier>
    <skos:prefLabel>Estate company customer</skos:prefLabel>
    <skos:definition xml:lang="en">The customer is an estate company customer. May be used when a company customer is bankrupt and the debtor's contract must be terminated.</skos:definition>
  </skos:Concept>
</rdf:RDF>
