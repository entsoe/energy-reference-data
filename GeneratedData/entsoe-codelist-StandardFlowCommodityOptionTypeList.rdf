<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:cim="http://iec.ch/TC57/2013/CIM-schema-cim16#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:ecl="urn:entsoe.eu:wgedi:codelists" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <skos:ConceptScheme rdf:about="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList">
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <dcterms:modified>2026-06-04</dcterms:modified>
    <dcat:version>95</dcat:version>
    <skos:prefLabel>StandardFlowCommodityOptionTypeList</skos:prefLabel>
    <dcterms:identifier>
        </dcterms:identifier>
    <skos:definition xml:lang="en">The option of flow commodity, such as production, consumption, combined or exchange. </skos:definition>
  </skos:ConceptScheme>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList/E17">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <dcterms:identifier>E17</dcterms:identifier>
    <skos:prefLabel>Consumption</skos:prefLabel>
    <skos:definition xml:lang="en">The coded identification of the type of entity, e.g. consumption metering point.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList/E18">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <dcterms:identifier>E18</dcterms:identifier>
    <skos:prefLabel>Production</skos:prefLabel>
    <skos:definition xml:lang="en">The coded identification of the type of entity, e.g. production metering point.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList/E19">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <dcterms:identifier>E19</dcterms:identifier>
    <skos:prefLabel>Combined</skos:prefLabel>
    <skos:definition xml:lang="en">The coded identification of the type of entity, e.g. combined consumption and production metering point.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList/E20">
    <skos:inScheme rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <skos:topConceptOf rdf:resource="http://energy.referencedata.eu/StandardFlowCommodityOptionTypeList"/>
    <dcterms:identifier>E20</dcterms:identifier>
    <skos:prefLabel>Exchange</skos:prefLabel>
    <skos:definition xml:lang="en">The coded identification of the type of entity, e.g. exchange metering point.</skos:definition>
  </skos:Concept>
</rdf:RDF>
