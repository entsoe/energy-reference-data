    "@skos:prefLabel": "Eclipse",
    "@skos:altLabel": "FR_ECLIPSE",
    "@skos:definition": {
        "@language": "en",
        "@value": "L'approvisionnement, l'achat, la revente, le négoce et le stockage d'électricité et l'équilibrage du réseau; le stockage d'électricité (notamment dans des batteries); la réalisation du négoce d'électricité sur tous les segments du marché; la réalisation et/ou la participation à des activités de recherche et de développement, de publication et/ou de partage des connaissances, notamment dans le domaine du stockage électrique."
    },
