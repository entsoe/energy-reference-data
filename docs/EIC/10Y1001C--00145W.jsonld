    "@skos:prefLabel": "Capacity Calculation Region Central Europe",
    "@skos:altLabel": "CCR-CE",
    "@skos:definition": {
        "@language": "en",
        "@value": "On 19 March 2024, ACER adopted Decision No 04/2024 establishing a new Capacity Calculation Region by merging the former Italy North and Core CCRs. The new EIC code is requested to identify this region. "
    },
