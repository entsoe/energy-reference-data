    <cim:IdentifiedObject.name>SE_SE4A_TP</cim:IdentifiedObject.name>
    <cim:Names.name>SE_SE4A_TP</cim:Names.name>
    <cim:IdentifiedObject.description>The EIC code represents an Aggregated Area defined by the TSO and used as a Technical Profile within the MARI and PICASSO balancing platforms.
The area is a virtual aggregation of several bidding zones and is used for modelling operational constraints and capacity limitations, in particular to limit flow variations over HVDC interconnections.
</cim:IdentifiedObject.description>
    <cim:Document.docStatus>A05</cim:Document.docStatus>
    <cim:AttributeInstanceComponent.attribute>International</cim:AttributeInstanceComponent.attribute>
    <cim:DateAndOrTime.date>2026-04-20</cim:DateAndOrTime.date>
    <cim:Names.name>Scheduling Area</cim:Names.name>
    <rdf:type rdf:resource="http://schema.org/Thing"/>
  </skos:Concept>
</rdf:RDF>
