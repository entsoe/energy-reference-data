    "@cim:Names.name": [
        "SE_SE4A_TP",
        "Scheduling Area"
    ],
    "@cim:IdentifiedObject.description": "The EIC code represents an Aggregated Area defined by the TSO and used as a Technical Profile within the MARI and PICASSO balancing platforms.\nThe area is a virtual aggregation of several bidding zones and is used for modelling operational constraints and capacity limitations, in particular to limit flow variations over HVDC interconnections.\n",
