    "@skos:prefLabel": "SE_SE4A_TP",
    "@skos:altLabel": "SE_SE4A_TP",
    "@skos:definition": {
        "@language": "en",
        "@value": "The EIC code represents an Aggregated Area defined by the TSO and used as a Technical Profile within the MARI and PICASSO balancing platforms.\nThe area is a virtual aggregation of several bidding zones and is used for modelling operational constraints and capacity limitations, in particular to limit flow variations over HVDC interconnections.\n"
    },
    "@cim:IdentifiedObject.mRID": "46Y000000000021S",
