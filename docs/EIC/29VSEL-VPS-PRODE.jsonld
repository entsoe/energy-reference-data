    "@skos:definition": {
        "@language": "en",
        "@value": "We are involved in the “Data Exchange for VP/S via ECP on PCN” project. To successfully register and operate our new ECP endpoints, we need a new V-Code for the production endpoint that will be used to access the VP/S."
