    <dcterms:identifier>urn:eic:29VSEL-VPS-PRODE</dcterms:identifier>
    <skos:prefLabel>SELENE CC RCC VPS endpoint production</skos:prefLabel>
    <skos:altLabel>SELRCC-VPS-PROD</skos:altLabel>
    <skos:definition xml:lang="en">We are involved in the &#8220;Data Exchange for VP/S via ECP on PCN&#8221; project. To successfully register and operate our new ECP endpoints, we need a new V-Code for the production endpoint that will be used to access the VP/S.</skos:definition>
    <cim:IdentifiedObject.mRID>29VSEL-VPS-PRODE</cim:IdentifiedObject.mRID>
