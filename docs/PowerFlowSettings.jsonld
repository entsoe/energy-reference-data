            "@cim:IdentifiedObject.name": "Model Debug set",
            "@cim:IdentifiedObject.description": "to be used for testing and model debug sessions. No business process is expected to run using these settings. It is not the only set of settings that can be used for the model debug. It is considered 1st choice. Main feature, control is disabled.",
            "@cim:PowerFlowSettings.algorithmKind": {
                "@id": "@cim:PowerFlowAlgorithmKind.fullNewtonRaphson"
            },
            "@cim:PowerFlowSettings.flatStart": "true",
