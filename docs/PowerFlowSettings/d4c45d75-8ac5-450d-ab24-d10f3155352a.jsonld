{
    "@id": "http://energy.referencedata.eu/PowerFlowSettings/d4c45d75-8ac5-450d-ab24-d10f3155352a",
    "@type": [
        "@skos:Concept",
        "@cim:PowerFlowSettings"
    ],
    "@cim:IdentifiedObject.mRID": "d4c45d75-8ac5-450d-ab24-d10f3155352a",
    "@cim:IdentifiedObject.name": "Model Debug set",
    "@cim:IdentifiedObject.description": "to be used for testing and model debug sessions. No business process is expected to run using these settings. It is not the only set of settings that can be used for the model debug. It is considered 1st choice. Main feature, control is disabled.",
    "@cim:PowerFlowSettings.algorithmKind": {
        "@id": "@cim:PowerFlowAlgorithmKind.fullNewtonRaphson"
    },
    "@cim:PowerFlowSettings.flatStart": "true",
    "@cim:PowerFlowSettings.flatStartInitialisationKind": {
        "@id": "@cim:FlatStartInitialisationKind.allNodesOneCondition"
    },
    "@cim:PowerFlowSettings.slackDistributionKind": {
        "@id": "@cim:SlackDistributionKind.generationDistributionParticipationFactor"
    },
    "@cim:PowerFlowSettings.activePowerTolerance": "0.1",
    "@cim:PowerFlowSettings.reactivePowerTolerance": "0.1",
    "@cim:PowerFlowSettings.voltageTolerance": "0.0001",
    "@cim:PowerFlowSettings.impedanceThreshold": "0.00003",
    "@cim:PowerFlowSettings.loadVoltageDependency": "false",
    "@cim:PowerFlowSettings.respectReactivePowerLimits": "true",
    "@cim:PowerFlowSettings.respectActivePowerLimits": "true",
    "@cim:PowerFlowSettings.excludeFromLimitCheck": {
        "@id": "@cim:LimitCheckExclusionKind.initialViolation"
    },
    "@cim:PowerFlowSettings.maxIterationsInnerLoop": "30",
    "@cim:PowerFlowSettings.maxIterationsOuterLoop": "30",
    "@cim:PowerFlowSettings.transformerRatioTapControl": "true",
    "@cim:PowerFlowSettings.transformerPhaseTapControl": "true",
    "@cim:PowerFlowSettings.switchedShuntControl": "true",
    "@cim:PowerFlowSettings.continuousControlPriority": "1",
    "@cim:PowerFlowSettings.interchangeControlEnabled": "true",
    "@cim:PowerFlowSettings.shiftKind": {
        "@id": "@cim:PowerShiftKind.conformLoadShift"
    },
    "@skos:prefLabel": "Model Debug set",
    "@skos:definition": {
        "@language": "en",
        "@value": "to be used for testing and model debug sessions. No business process is expected to run using these settings. It is not the only set of settings that can be used for the model debug. It is considered 1st choice. Main feature, control is disabled."
    },
    "@dcterms:identifier": "urn:uuid:d4c45d75-8ac5-450d-ab24-d10f3155352a",
