<http://energy.referencedata.eu/PowerFlowSettings/23573ff8-f567-48c6-ab93-3df92afb3c35> a cim:PowerFlowSettings,
        skos:Concept ;
    cim:IdentifiedObject.description "to be used by EMF in the merging process (CGM Build process)" ;
    cim:IdentifiedObject.mRID "23573ff8-f567-48c6-ab93-3df92afb3c35" ;
    cim:IdentifiedObject.name "CGM set" ;
    cim:PowerFlowSettings.activePowerTolerance "0.1" ;
    cim:PowerFlowSettings.algorithmKind cim:PowerFlowAlgorithmKind.fullNewtonRaphson ;
    cim:PowerFlowSettings.continuousControlPriority "1" ;
    cim:PowerFlowSettings.excludeFromLimitCheck cim:LimitCheckExclusionKind.initialViolation ;
    cim:PowerFlowSettings.flatStart "true" ;
    cim:PowerFlowSettings.flatStartInitialisationKind cim:FlatStartInitialisationKind.allNodesOneCondition ;
    cim:PowerFlowSettings.impedanceThreshold "0.00003" ;
    cim:PowerFlowSettings.interchangeControlEnabled "true" ;
    cim:PowerFlowSettings.loadVoltageDependency "false" ;
    cim:PowerFlowSettings.maxIterationsInnerLoop "50" ;
    cim:PowerFlowSettings.maxIterationsOuterLoop "50" ;
    cim:PowerFlowSettings.reactivePowerTolerance "0.1" ;
    cim:PowerFlowSettings.respectActivePowerLimits "true" ;
    cim:PowerFlowSettings.respectReactivePowerLimits "true" ;
    cim:PowerFlowSettings.shiftKind cim:PowerShiftKind.conformLoadShift ;
    cim:PowerFlowSettings.slackDistributionKind cim:SlackDistributionKind.generationDistributionParticipationFactor ;
    cim:PowerFlowSettings.switchedShuntControl "true" ;
    cim:PowerFlowSettings.switchedShuntControlPriority "4" ;
    cim:PowerFlowSettings.transformerPhaseTapControl "true" ;
    cim:PowerFlowSettings.transformerPhaseTapControlPriority "2" ;
    cim:PowerFlowSettings.transformerRatioTapControl "true" ;
    cim:PowerFlowSettings.transformerRatioTapControlPriority "3" ;
    cim:PowerFlowSettings.voltageTolerance "0.0001" ;
    dcterms:identifier "urn:uuid:23573ff8-f567-48c6-ab93-3df92afb3c35" ;
    skos:definition "to be used by EMF in the merging process (CGM Build process)"@en ;
