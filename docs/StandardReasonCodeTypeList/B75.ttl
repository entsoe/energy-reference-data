@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://energy.referencedata.eu/StandardReasonCodeTypeList/B75> a skos:Concept ;
    dcterms:identifier "B75" ;
    skos:definition """Based on the regulation (EU) 2016/679 (GDPR) Article 6, Lawfulness of processing: Processing is necessary for the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller.
"""@en ;
    skos:inScheme <http://energy.referencedata.eu/StandardReasonCodeTypeList> ;
    skos:prefLabel "In order to perform a duty of common (national) interest" ;
    skos:topConceptOf <http://energy.referencedata.eu/StandardReasonCodeTypeList> .

