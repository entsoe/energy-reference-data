@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://energy.referencedata.eu/StandardReasonCodeTypeList/B72> a skos:Concept ;
    dcterms:identifier "B72" ;
    skos:definition "Based on the regulation (EU) 2016/679 (GDPR) Article 6, Lawfulness of processing: Processing is necessary for the performance of a contract to which the data subject is party or in order to take steps at the request of the data subject prior to entering into a contract."@en ;
    skos:inScheme <http://energy.referencedata.eu/StandardReasonCodeTypeList> ;
    skos:prefLabel "In execution of a contract with the customer (Execution of contract)" ;
    skos:topConceptOf <http://energy.referencedata.eu/StandardReasonCodeTypeList> .

