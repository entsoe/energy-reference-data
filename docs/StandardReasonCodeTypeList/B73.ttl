@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://energy.referencedata.eu/StandardReasonCodeTypeList/B73> a skos:Concept ;
    dcterms:identifier "B73" ;
    skos:definition "Based on the regulation (EU) 2016/679 (GDPR) Article 6, Lawfulness of processing: Processing is necessary for compliance with a legal obligation to which the controller is subject."@en ;
    skos:inScheme <http://energy.referencedata.eu/StandardReasonCodeTypeList> ;
    skos:prefLabel "Legal obligations" ;
    skos:topConceptOf <http://energy.referencedata.eu/StandardReasonCodeTypeList> .

