    "@dcterms:identifier": "B74",
    "@skos:prefLabel": "In protection of vital interests of the customer",
    "@skos:definition": {
        "@language": "en",
        "@value": "Based on the regulation (EU) 2016/679 (GDPR) Article 6, Lawfulness of processing: Processing is necessary in order to protect the vital interests of the data subject or of another natural person.\n"
    },
