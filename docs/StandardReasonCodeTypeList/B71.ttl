@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://energy.referencedata.eu/StandardReasonCodeTypeList/B71> a skos:Concept ;
    dcterms:identifier "B71" ;
    skos:definition "Based on the regulation (EU) 2016/679 (GDPR) Article 6, Lawfulness of processing: The data subject has given consent to the processing of his or her personal data for one or more specific purposes."@en ;
    skos:inScheme <http://energy.referencedata.eu/StandardReasonCodeTypeList> ;
    skos:prefLabel "(Explicit) Permission from the customer" ;
    skos:topConceptOf <http://energy.referencedata.eu/StandardReasonCodeTypeList> .

