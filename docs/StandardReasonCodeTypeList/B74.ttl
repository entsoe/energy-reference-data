@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://energy.referencedata.eu/StandardReasonCodeTypeList/B74> a skos:Concept ;
    dcterms:identifier "B74" ;
    skos:definition """Based on the regulation (EU) 2016/679 (GDPR) Article 6, Lawfulness of processing: Processing is necessary in order to protect the vital interests of the data subject or of another natural person.
"""@en ;
    skos:inScheme <http://energy.referencedata.eu/StandardReasonCodeTypeList> ;
    skos:prefLabel "In protection of vital interests of the customer" ;
    skos:topConceptOf <http://energy.referencedata.eu/StandardReasonCodeTypeList> .

